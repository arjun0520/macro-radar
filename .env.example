# Required
APP_PASSWORD="replace-with-a-long-private-password"
AUTH_SECRET="replace-with-random-32-byte-secret"
CRON_SECRET="replace-with-random-cron-secret"
DATABASE_URL="postgres://..."
OPENAI_API_KEY="sk-..."

# Recommended
OPENAI_MODEL="gpt-5.5"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional free/official sources
FRED_API_KEY=""
BLS_API_KEY=""
FINNHUB_API_KEY=""
SEC_USER_AGENT="MacroRadar/0.1 your-email@example.com"
TRADING_ECONOMICS_API_KEY=""
FMP_API_KEY=""

# Optional email delivery. If omitted, alerts are saved in-app but not emailed.
ALERT_EMAIL_TO="you@example.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Macro Radar <alerts@example.com>"
